---
interface Props {
  status: 'coordinating' | 'fixed' | 'published' | 'unfixed';
}
const { status } = Astro.props;
const label = {
  coordinating: 'Coordinating',
  fixed: 'Fixed',
  published: 'Published',
  unfixed: 'Unfixed by vendor',
}[status];
---

<span class={`badge status status-${status}`}><span class="sr-only">Status: </span><span class="dot" aria-hidden="true"></span><span class="badge-label">{label}</span></span>
