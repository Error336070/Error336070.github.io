---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SeverityBadge from '../../components/SeverityBadge.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { SITE } from '../../site.config';
import { getAdvisories, fmtDate, isoDate, daysBetween } from '../../lib/content';

export async function getStaticPaths() {
  const advisories = await getAdvisories();
  return advisories.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const cweLink = (c: string) => `https://cwe.mitre.org/data/definitions/${c.replace(/\D/g, '')}.html`;
const cveLink = (c: string) => `https://www.cve.org/CVERecord?id=${c}`;
const days = daysBetween(d.reported, d.published);
---

<Base title={`${d.advisoryId}: ${d.title}`} description={d.summary} ogType="article">
  <article class="advisory">
    <header class="page-head adv-head">
      <p class="eyebrow"><span class="adv-kicker">Security advisory</span> <span class="adv-id">{d.advisoryId}</span></p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <p class="adv-keys">
        <SeverityBadge severity={d.severity} />
        <StatusBadge status={d.status} />
      </p>
    </header>

    <dl class="facts">
      <div><dt>Vendor</dt><dd>{d.vendor}</dd></div>
      <div><dt>Product</dt><dd>{d.product}</dd></div>
      <div><dt>Affected</dt><dd>{d.affected}</dd></div>
      <div><dt>Fixed in</dt><dd>{d.fixed ?? <span class="muted">None known at publication</span>}</dd></div>
      <div><dt>CVE</dt><dd>{d.cve.length ? d.cve.map((c) => <a class="ref" href={cveLink(c)}>{c}</a>) : <span class="muted">None assigned</span>}</dd></div>
      <div><dt>CWE</dt><dd>{d.cwe.length ? d.cwe.map((c) => <a class="ref" href={cweLink(c)}>{c}</a>) : <span class="muted">None assigned</span>}</dd></div>
      {d.coordinator && <div><dt>Coordinator</dt><dd>{d.coordinator}{d.caseNumber && <span class="ref">{d.caseNumber}</span>}</dd></div>}
      <div><dt>Vendor acknowledgment</dt><dd>{d.vendorAcknowledged ? 'Acknowledged' : 'No acknowledgment recorded'}</dd></div>
      <div><dt>Credit</dt><dd>{SITE.name} ({SITE.handle})</dd></div>
    </dl>

    <dl class="span">
      <div class="span-end"><dt>Reported</dt><dd><time datetime={isoDate(d.reported)}>{fmtDate(d.reported)}</time></dd></div>
      <div class="span-gap"><dt class="sr-only">Time from report to publication</dt><dd>{days} {days === 1 ? 'day' : 'days'}</dd></div>
      <div class="span-end"><dt>Published</dt><dd><time datetime={isoDate(d.published)}>{fmtDate(d.published)}</time></dd></div>
    </dl>

    <div class="prose">
      <Content />
    </div>

    <footer class="adv-foot">
      <p>Reported and published under the <a href="/disclosure-policy/">disclosure policy</a>. Corrections and vendor statements are welcome at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      <p><a class="arrow-link" href="/advisories/">All advisories</a></p>
    </footer>
  </article>
</Base>
