---
import Base from '../../layouts/Base.astro';
import AdvisoryCard from '../../components/AdvisoryCard.astro';
import { getAdvisories } from '../../lib/content';

const advisories = await getAdvisories();
---

<Base title="Advisories" description="Coordinated vulnerability disclosures and security advisories.">
  <header class="page-head">
    <p class="eyebrow">Advisories</p>
    <h1>Security advisories</h1>
    <p class="lede">Coordinated disclosures. Each entry is published only after the vendor has had a fair chance to fix the issue. The process is in the <a href="/disclosure-policy/">disclosure policy</a>.</p>
  </header>

  {advisories.length === 0 ? (
    <p class="empty">No public advisories yet. An advisory appears here after the vendor has shipped a fix or the disclosure window has closed.</p>
  ) : (
    <div class="card-list">
      {advisories.map((entry) => <AdvisoryCard entry={entry} level={2} />)}
    </div>
  )}
</Base>
