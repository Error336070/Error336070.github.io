---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getResearch, fmtDate, isoDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getResearch();
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article>
    <p class="eyebrow">
      <time datetime={isoDate(entry.data.date)}>{fmtDate(entry.data.date)}</time>
      {entry.data.tags.map((t) => <span class="tag">#{t}</span>)}
    </p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
