---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FieldTag from '../../components/FieldTag.astro';
import { getResearch, fmtDate, isoDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getResearch();
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={d.title} description={d.summary} ogType="article">
  <article class="post">
    <header class="page-head">
      <p class="eyebrow post-meta">
        <time datetime={isoDate(d.date)}>{fmtDate(d.date)}</time>
        <span class="fields">{d.field.map((f) => <FieldTag field={f} />)}</span>
      </p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      {d.tags.length > 0 && <ul class="tags" aria-label="Topics">{d.tags.map((t) => <li>#{t}</li>)}</ul>}
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="adv-foot">
      <p><a class="arrow-link" href="/research/">All research</a></p>
    </footer>
  </article>
</Base>
