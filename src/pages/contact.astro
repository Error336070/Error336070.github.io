---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
---

<Base title="Contact">
  <article class="prose">
    <h1>Contact</h1>
    <p class="lede">For security reports, vendor coordination and audit inquiries.</p>

    <dl class="facts">
      <div><dt>Email</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
      <div><dt>PGP key</dt><dd><a href="/pgp.asc">/pgp.asc</a></dd></div>
      <div><dt>Fingerprint</dt><dd><code class="fingerprint">{SITE.pgpFingerprint}</code></dd></div>
      <div><dt>GitHub</dt><dd><a href={SITE.github} rel="me">{SITE.github.replace('https://', '')}</a></dd></div>
      <div><dt>security.txt</dt><dd><a href="/.well-known/security.txt">/.well-known/security.txt</a></dd></div>
    </dl>

    <h2>Vendors</h2>
    <p>
      If you've received a report from me, please reply to the same thread. Encrypted email is preferred for
      anything containing technical detail. My process and timelines are in the
      <a href="/disclosure-policy/">disclosure policy</a>.
    </p>
  </article>
</Base>
