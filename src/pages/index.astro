---
import Base from '../layouts/Base.astro';
import SeverityBadge from '../components/SeverityBadge.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { SITE } from '../site.config';
import { getAdvisories, getResearch, fmtDate, isoDate } from '../lib/content';

const advisories = (await getAdvisories()).slice(0, 5);
const research = (await getResearch()).slice(0, 5);
---

<Base>
  <section class="hero">
    <p class="eyebrow">{SITE.handle}</p>
    <h1>{SITE.name}</h1>
    <p class="lede">{SITE.tagline}</p>
    <p class="hero-links">
      <a class="btn" href="/advisories/">Advisories</a>
      <a class="btn ghost" href="/contact/">Report a finding / get in touch</a>
    </p>
  </section>

  <section>
    <div class="section-head">
      <h2>Latest advisories</h2>
      <a href="/advisories/">All advisories →</a>
    </div>
    {advisories.length === 0 ? (
      <p class="empty">No public advisories yet. Disclosures appear here once the vendor fix window has closed.</p>
    ) : (
      <ul class="list">
        {advisories.map((a) => (
          <li class="item">
            <div class="item-meta">
              <code>{a.data.advisoryId}</code>
              <SeverityBadge severity={a.data.severity} />
              <StatusBadge status={a.data.status} />
              <time datetime={isoDate(a.data.published)}>{fmtDate(a.data.published)}</time>
            </div>
            <a class="item-title" href={`/advisories/${a.id}/`}>{a.data.title}</a>
            <p class="item-summary">{a.data.summary}</p>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section>
    <div class="section-head">
      <h2>Research &amp; write-ups</h2>
      <a href="/research/">All research →</a>
    </div>
    {research.length === 0 ? (
      <p class="empty">Write-ups coming soon.</p>
    ) : (
      <ul class="list">
        {research.map((r) => (
          <li class="item">
            <div class="item-meta">
              <time datetime={isoDate(r.data.date)}>{fmtDate(r.data.date)}</time>
              {r.data.tags.map((t) => <span class="tag">#{t}</span>)}
            </div>
            <a class="item-title" href={`/research/${r.id}/`}>{r.data.title}</a>
            <p class="item-summary">{r.data.summary}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
